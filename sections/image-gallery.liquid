{%- liquid
  assign count = section.blocks.size
  assign cols_even = count
  if cols_even < 1
    assign cols_even = 1
  endif
  assign n_others = count | minus: 1
  if n_others < 1
    assign n_others = 1
  endif
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank -%}
      <h2 class="image-gallery__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div
      class="image-gallery__grid image-gallery--{{ section.settings.layout }} image-gallery--count-{{ count }}"
      style="
        --gal-gap: {{ section.settings.gap }}px;
        --gal-row: {{ section.settings.row_height }}px;
        --gal-radius: {{ section.settings.radius }}px;
        --gal-cols: {{ cols_even }};
        --gal-n: {{ n_others }};
      "
    >
      {%- for block in section.blocks -%}
        {%- capture tile -%}
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 1200
              | image_tag:
                class: 'image-gallery__image',
                loading: 'lazy',
                widths: '600, 900, 1200',
                sizes: '(min-width: 750px) 50vw, 100vw'
            }}
          {%- else -%}
            {{ 'hero-apparel-1' | placeholder_svg_tag: 'image-gallery__image' }}
          {%- endif -%}
          {%- if section.settings.show_captions and block.settings.caption != blank -%}
            <span class="image-gallery__caption">{{ block.settings.caption }}</span>
          {%- endif -%}
        {%- endcapture -%}

        <div class="image-gallery__item" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" class="image-gallery__link">{{ tile }}</a>
          {%- else -%}
            <div class="image-gallery__link">{{ tile }}</div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .image-gallery__heading {
    margin: 0 0 2rem;
    text-align: center;
  }

  .image-gallery__grid {
    display: grid;
    gap: var(--gal-gap);
  }

  .image-gallery__item {
    position: relative;
    overflow: hidden;
    border-radius: var(--gal-radius);
  }

  .image-gallery__link {
    display: block;
    position: relative;
    width: 100%;
    height: 100%;
    color: #fff;
    text-decoration: none;
  }

  .image-gallery__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  a.image-gallery__link:hover .image-gallery__image {
    transform: scale(1.04);
  }

  .image-gallery__caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 3rem 1.6rem 1.4rem;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.55), transparent);
    font-size: 1.5rem;
  }

  /* ---------- Phones: collage ---------- */
  /* Two columns. The first image is full width and taller,
     and a lone last image also goes full width. */
  @media screen and (max-width: 749px) {
    .image-gallery__grid {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: calc(var(--gal-row) * 0.7);
    }
    .image-gallery__item:first-child {
      grid-column: 1 / -1;
      grid-row: span 2;
    }
    .image-gallery__item:last-child:nth-child(even) {
      grid-column: 1 / -1;
    }
  }

  /* ---------- Tablet and desktop: chosen layout ---------- */
  @media screen and (min-width: 750px) {
    /* Layout 1: even grid (one row, equal tiles) */
    .image-gallery--grid {
      grid-template-columns: repeat(var(--gal-cols), 1fr);
      grid-auto-rows: var(--gal-row);
    }

    /* Layout 2: one big image on the left, the rest stacked on the right */
    .image-gallery--feature-left {
      grid-template-columns: 3fr 2fr;
      grid-template-rows: repeat(var(--gal-n), var(--gal-row));
    }
    .image-gallery--feature-left .image-gallery__item:first-child {
      grid-column: 1;
      grid-row: 1 / -1;
    }
    .image-gallery--feature-left .image-gallery__item:not(:first-child) {
      grid-column: 2;
    }

    /* Layout 3: one wide image on top, the rest in a row below */
    .image-gallery--feature-top {
      grid-template-columns: repeat(var(--gal-n), 1fr);
      grid-template-rows: calc(var(--gal-row) * 1.5) var(--gal-row);
    }
    .image-gallery--feature-top .image-gallery__item:first-child {
      grid-column: 1 / -1;
    }

    /* Layout 4: mosaic (tall left, two stacked in the middle, tall right) */
    .image-gallery--mosaic {
      grid-template-columns: repeat(3, 1fr);
      grid-template-rows: repeat(2, var(--gal-row));
    }
    .image-gallery--mosaic .image-gallery__item:nth-child(1) {
      grid-column: 1;
      grid-row: 1 / 3;
    }
    .image-gallery--mosaic .image-gallery__item:nth-child(2) {
      grid-column: 2;
      grid-row: 1;
    }
    .image-gallery--mosaic .image-gallery__item:nth-child(3) {
      grid-column: 2;
      grid-row: 2;
    }
    .image-gallery--mosaic .image-gallery__item:nth-child(4) {
      grid-column: 3;
      grid-row: 1 / 3;
    }

    /* Mosaic with fewer images */
    .image-gallery--mosaic.image-gallery--count-1 {
      grid-template-columns: 1fr;
    }
    .image-gallery--mosaic.image-gallery--count-2 .image-gallery__item:nth-child(2) {
      grid-row: 1 / 3;
    }
    .image-gallery--mosaic.image-gallery--count-2,
    .image-gallery--mosaic.image-gallery--count-3 {
      grid-template-columns: repeat(2, 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Image gallery",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our gallery" },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout (desktop)",
      "options": [
        { "value": "grid", "label": "Even grid" },
        { "value": "feature-left", "label": "Big image left" },
        { "value": "feature-top", "label": "Big image on top" },
        { "value": "mosaic", "label": "Mosaic" }
      ],
      "default": "feature-left"
    },
    { "type": "checkbox", "id": "show_captions", "label": "Show captions", "default": true },
    {
      "type": "range",
      "id": "row_height",
      "label": "Row height",
      "min": 160,
      "max": 400,
      "step": 20,
      "unit": "px",
      "default": 260
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Space between images",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "caption", "label": "Caption" },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image gallery",
      "blocks": [{ "type": "image" }, { "type": "image" }, { "type": "image" }, { "type": "image" }]
    }
  ]
}
{% endschema %}
