{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank -%}
      <h2 class="testimonials__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div
      class="testimonials__grid"
      style="
        --test-cols: {{ section.settings.columns }};
        --test-avatar: {{ section.settings.avatar_size }}px;
        --test-radius: {{ section.settings.card_radius }}px;
      "
    >
      {%- for block in section.blocks -%}
        <figure class="testimonials__card" {{ block.shopify_attributes }}>
          <div class="testimonials__avatar">
            {%- if block.settings.avatar != blank -%}
              {{
                block.settings.avatar
                | image_url: width: 240
                | image_tag: class: 'testimonials__avatar-image', loading: 'lazy', widths: '120, 240'
              }}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'testimonials__avatar-image' }}
            {%- endif -%}
          </div>

          {%- if block.settings.rating > 0 -%}
            <div class="testimonials__stars" aria-label="{{ block.settings.rating }} out of 5 stars">
              {%- for i in (1..block.settings.rating) -%}
                &#9733;
              {%- endfor -%}
            </div>
          {%- endif -%}

          {%- if block.settings.quote != blank -%}
            <blockquote class="testimonials__quote">{{ block.settings.quote }}</blockquote>
          {%- endif -%}

          <figcaption class="testimonials__author">
            {%- if block.settings.name != blank -%}
              <strong class="testimonials__name">{{ block.settings.name }}</strong>
            {%- endif -%}
            {%- if block.settings.role != blank -%}
              <span class="testimonials__role">{{ block.settings.role }}</span>
            {%- endif -%}
          </figcaption>
        </figure>
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .testimonials__heading {
    margin: 0 0 3rem;
    text-align: center;
  }

  .testimonials__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  @media screen and (min-width: 750px) {
    .testimonials__grid {
      grid-template-columns: repeat(min(var(--test-cols), 2), 1fr);
    }
  }
  @media screen and (min-width: 990px) {
    .testimonials__grid {
      grid-template-columns: repeat(var(--test-cols), 1fr);
    }
  }

  .testimonials__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.2rem;
    margin: 0;
    padding: 3rem 2.4rem;
    text-align: center;
    border-radius: var(--test-radius);
    background: rgba(var(--color-foreground), 0.05);
  }

  .testimonials__avatar {
    width: var(--test-avatar);
    height: var(--test-avatar);
    flex-shrink: 0;
    overflow: hidden;
    border-radius: 50%;
  }
  .testimonials__avatar-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .testimonials__stars {
    color: #e0a526;
    font-size: 1.8rem;
    letter-spacing: 0.2rem;
  }

  .testimonials__quote {
    margin: 0;
    font-style: italic;
    line-height: 1.6;
  }

  .testimonials__author {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .testimonials__role {
    font-size: 1.3rem;
    opacity: 0.7;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Testimonials",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What our customers say" },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns on desktop",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "avatar_size",
      "label": "Profile image size",
      "min": 56,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 88
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "image_picker", "id": "avatar", "label": "Profile image" },
        {
          "type": "range",
          "id": "rating",
          "label": "Star rating (0 hides stars)",
          "min": 0,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Testimonial",
          "default": "My skin feels softer and brighter after just two weeks. I love this routine!"
        },
        { "type": "text", "id": "name", "label": "Name", "default": "Customer name" },
        { "type": "text", "id": "role", "label": "Role or location", "default": "Verified buyer" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [{ "type": "testimonial" }, { "type": "testimonial" }, { "type": "testimonial" }]
    }
  ]
}
{% endschema %}
